{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "groupName": "AndroidX dependencies",
      "matchPackageNames": [
        "/^androidx\\./"
      ]
    },
    {
      "groupName": "Kotlin dependencies",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin/"
      ]
    },
    {
      "groupName": "Android Gradle Plugin",
      "matchPackageNames": [
        "/^com\\.android\\.tools\\.build/"
      ]
    },
    {
      "groupName": "AboutLibraries dependencies",
      "matchPackageNames": [
        "/^com\\.mikepenz/"
      ]
    }
  ]
}
