<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing"
        android:value="false" />

    <application
        android:name="com.cylonid.nativealpha.util.App"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/native_alpha"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/native_alpha"
        android:supportsRtl="true"
        android:screenOrientation="portrait"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:fullBackupContent="true">

        <activity
            android:name="com.cylonid.nativealpha.MainActivity"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.Launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

<!--        Make sure to also copy changes to WebViewActivity in build.gradle-->
        <activity
            android:name=".WebViewActivity"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:icon="@mipmap/native_alpha"
            android:roundIcon="@mipmap/native_alpha"
            android:theme="@style/AppTheme.WebView"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode|keyboard|keyboardHidden|navigation"
            android:launchMode="standard"
            android:documentLaunchMode="intoExisting"
            />
        <!-- Sandboxed WebView Activities -->
        <activity
            android:name=".WebSandboxActivity0"
            android:label="@string/app_name"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:icon="@mipmap/native_alpha"
            android:roundIcon="@mipmap/native_alpha"
            android:theme="@style/AppTheme.WebView"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode|keyboard|keyboardHidden|navigation"
            android:launchMode="standard"
            android:process=":web_sandbox_0"
            android:documentLaunchMode="intoExisting" />
        <activity-alias
            android:name=".__WebViewActivity_0"
            android:targetActivity=".WebSandboxActivity0"
            android:exported="true" />
